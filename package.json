{
  "name": "skyditor",
  "private": true,
  "version": "0.0.1",
  "license": "CC0-1.0",
  "type": "module",
  "description": "A focused, game-feel OpenStreetMap landuse editor. M0: toy.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "trace": "node scripts/trace.mjs",
    "fixture": "node scripts/make-fixture.mjs"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^22.20.5",
    "@types/rbush": "^4.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
